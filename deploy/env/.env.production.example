STRIPE_PRICE_TEAM=price_replace_me
STRIPE_PRICE_TOP_UP_25=price_replace_me
STRIPE_PRICE_TOP_UP_100=price_replace_me
STRIPE_PRICE_TOP_UP_250=price_replace_me
SUPPORT_RECIPIENTS="info@your-domain.com,garyconstable80@gmail.com"
CASHIER_CURRENCY=gbp
CASHIER_CURRENCY_LOCALE=en_GB

GHOSTFROG_ENGINE_URL=http://127.0.0.1:8001
GHOSTFROG_ENGINE_SHARED_SECRET=replace-me
GHOSTFROG_ENGINE_CALLBACK_SECRET=replace-me
