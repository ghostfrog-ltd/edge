[Unit]
Description=Ghostfrog FastAPI Engine
After=network.target

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/ghostfrog/engine
EnvironmentFile=/var/www/ghostfrog/.env
ExecStart=/var/www/ghostfrog/engine/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
